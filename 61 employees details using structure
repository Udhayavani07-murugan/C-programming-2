#include <stdio.h>

struct Employee {
    int id;
    char name[50];
    float salary;
};

int main() {
    struct Employee e;

    printf("Enter employee ID: ");
    scanf("%d", &e.id);
    printf("Enter employee name: ");
    scanf(" %[^\n]", e.name);
    printf("Enter salary: ");
    scanf("%f", &e.salary);

    printf("\nEmployee Details:\nID: %d\nName: %s\nSalary: %.2f\n", e.id, e.name, e.salary);
    return 0;
}
