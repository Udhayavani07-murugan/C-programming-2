#include <stdio.h>

struct BankAccount {
    int accNo;
    char name[50];
    float balance;
};

int main() {
    struct BankAccount acc;

    printf("Enter account number: ");
    scanf("%d", &acc.accNo);
    printf("Enter account holder name: ");
    scanf(" %[^\n]", acc.name);
    printf("Enter balance: ");
    scanf("%f", &acc.balance);

    printf("\nBank Account Details:\nAccount No: %d\nName: %s\nBalance: %.2f\n", acc.accNo, acc.name, acc.balance);
    return 0;
}
