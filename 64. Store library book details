#include <stdio.h>

struct Book {
    int id;
    char title[50];
    char author[50];
};

int main() {
    struct Book b;

    printf("Enter book ID: ");
    scanf("%d", &b.id);
    printf("Enter book title: ");
    scanf(" %[^\n]", b.title);
    printf("Enter author name: ");
    scanf(" %[^\n]", b.author);

    printf("\nBook Details:\nID: %d\nTitle: %s\nAuthor: %s\n", b.id, b.title, b.author);
    return 0;
}
