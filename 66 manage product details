#include <stdio.h>

struct Product {
    int id;
    char name[50];
    float price;
};

int main() {
    struct Product p;

    printf("Enter product ID: ");
    scanf("%d", &p.id);
    printf("Enter product name: ");
    scanf(" %[^\n]", p.name);
    printf("Enter price: ");
    scanf("%f", &p.price);

    printf("\nProduct Details:\nID: %d\nName: %s\nPrice: %.2f\n", p.id, p.name, p.price);
    return 0;
}
