#include <stdio.h>

struct Mobile {
    char brand[50];
    char model[50];
    float price;
};

int main() {
    struct Mobile m;

    printf("Enter mobile brand: ");
    scanf(" %[^\n]", m.brand);
    printf("Enter mobile model: ");
    scanf(" %[^\n]", m.model);
    printf("Enter price: ");
    scanf("%f", &m.price);

    printf("\nMobile Details:\nBrand: %s\nModel: %s\nPrice: %.2f\n", m.brand, m.model, m.price);
    return 0;
}
