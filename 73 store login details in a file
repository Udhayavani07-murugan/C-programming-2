#include <stdio.h>

struct Login {
    char username[50];
    char password[50];
};

int main() {
    struct Login l;
    FILE *fp;

    printf("Enter username: ");
    scanf("%s", l.username);
    printf("Enter password: ");
    scanf("%s", l.password);

    fp = fopen("logins.txt", "a"); // Append mode
    if (fp == NULL) {
        printf("Error opening file.\n");
        return 1;
    }

    fprintf(fp, "Username: %s, Password: %s\n", l.username, l.password);
    fclose(fp);

    printf("Login details saved successfully.\n");
    return 0;
}
