#include <stdio.h>

struct Sale {
    int id;
    char product[50];
    int quantity;
    float price;
};

int main() {
    struct Sale s;
    FILE *fp;

    printf("Enter sale ID: ");
    scanf("%d", &s.id);
    printf("Enter product name: ");
    scanf(" %[^\n]", s.product);
    printf("Enter quantity sold: ");
    scanf("%d", &s.quantity);
    printf("Enter price per unit: ");
    scanf("%f", &s.price);

    fp = fopen("sales.txt", "a"); // Append mode
    if (fp == NULL) {
        printf("Error opening file.\n");
        return 1;
    }

    fprintf(fp, "ID: %d, Product: %s, Quantity: %d, Price: %.2f\n", s.id, s.product, s.quantity, s.price);
    fclose(fp);

    printf("Sales report saved successfully.\n");
    return 0;
}
