#include <stdio.h>

int main() {
    FILE *fp;
    char ch;
    int count = 0;

    fp = fopen("records.txt", "r"); // Open the file in read mode
    if (fp == NULL) {
        printf("Error: Cannot open file.\n");
        return 1;
    }

    // Count lines in the file
    while ((ch = fgetc(fp)) != EOF) {
        if (ch == '\n') {
            count++;
        }
    }

    fclose(fp);

    printf("Number of records (lines) in the file: %d\n", count);
    return 0;
}
