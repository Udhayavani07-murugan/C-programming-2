#include <stdio.h>

int main() {
    FILE *fp;
    char data[100];

    fp = fopen("data.txt", "a"); // Append mode
    if (fp == NULL) {
        printf("Error opening file.\n");
        return 1;
    }

    printf("Enter data to append: ");
    scanf(" %[^\n]", data);

    fprintf(fp, "%s\n", data); // Write to file
    fclose(fp);

    printf("Data appended successfully.\n");
    return 0;
}
