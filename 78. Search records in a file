#include <stdio.h>
#include <string.h>

int main() {
    FILE *fp;
    char record[100];
    char search[50];
    int found = 0;

    fp = fopen("data.txt", "r");
    if (fp == NULL) {
        printf("Error opening file.\n");
        return 1;
    }

    printf("Enter text to search: ");
    scanf(" %[^\n]", search);

    while (fgets(record, sizeof(record), fp) != NULL) {
        if (strstr(record, search) != NULL) {
            printf("Record found: %s", record);
            found = 1;
            break;
        }
    }

    if (!found)
        printf("Record not found.\n");

    fclose(fp);
    return 0;
}
