#include <stdio.h>

int main() {
    int n, i;
    float rainfall[50], total = 0, average;

    printf("Enter number of days: ");
    scanf("%d", &n);

    // Input rainfall values
    for(i = 0; i < n; i++) {
        printf("Enter rainfall for day %d: ", i + 1);
        scanf("%f", &rainfall[i]);
        total += rainfall[i];
    }

    // Calculate average
    average = total / n;

    // Display result
    printf("\nTotal rainfall = %.2f\n", total);
    printf("Average rainfall = %.2f\n", average);

    return 0;
}
