#include <stdio.h>

int main() {
    int n, i, qty;
    float price, total = 0;

    printf("Enter number of items: ");
    scanf("%d", &n);

    for(i = 1; i <= n; i++) {
        printf("\nEnter price of item %d: ", i);
        scanf("%f", &price);

        printf("Enter quantity of item %d: ", i);
        scanf("%d", &qty);

        total = total + (price * qty);
    }

    printf("\nTotal Bill Amount = Rs. %.2f", total);

    return 0;
}
