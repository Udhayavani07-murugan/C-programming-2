#include <stdio.h>

int main() {
    int n1, n2, i;
    int arr1[50], arr2[50], merged[100];

    printf("Enter number of elements in first array: ");
    scanf("%d", &n1);

    // Input first array
    for(i = 0; i < n1; i++) {
        printf("Enter element %d: ", i + 1);
        scanf("%d", &arr1[i]);
        merged[i] = arr1[i];
    }

    printf("\nEnter number of elements in second array: ");
    scanf("%d", &n2);

    // Input second array
    for(i = 0; i < n2; i++) {
        printf("Enter element %d: ", i + 1);
        scanf("%d", &arr2[i]);
        merged[n1 + i] = arr2[i];
    }

    // Display merged array
    printf("\nMerged array:\n");
    for(i = 0; i < n1 + n2; i++) {
        printf("%d ", merged[i]);
    }

    return 0;
}
