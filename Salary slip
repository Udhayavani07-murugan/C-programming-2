#include <stdio.h>

int main() {
    int empId;
    float basic, allowance, deduction, netSalary;

    printf("Enter Employee ID: ");
    scanf("%d", &empId);

    printf("Enter Basic Salary: ");
    scanf("%f", &basic);

    printf("Enter Allowance: ");
    scanf("%f", &allowance);

    printf("Enter Deduction: ");
    scanf("%f", &deduction);

    netSalary = basic + allowance - deduction;

    printf("\n----- Salary Slip -----\n");
    printf("Employee ID : %d\n", empId);
    printf("Basic Salary: Rs %.2f\n", basic);
    printf("Allowance   : Rs %.2f\n", allowance);
    printf("Deduction   : Rs %.2f\n", deduction);
    printf("Net Salary  : Rs %.2f\n", netSalary);

    return 0;
}
