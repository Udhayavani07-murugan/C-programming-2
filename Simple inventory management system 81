#include <stdio.h>

struct Item {
    int id;
    char name[20];
    int qty;
};

int main() {
    struct Item inv[10];
    int n = 0, choice, i, searchId;

    do {
        printf("\n1.Add 2.Display 3.Search 4.Update 5.Exit\n");
        scanf("%d", &choice);

        if(choice == 1) {
            scanf("%d %s %d", &inv[n].id, inv[n].name, &inv[n].qty);
            n++;
        }
        else if(choice == 2) {
            for(i = 0; i < n; i++)
                printf("%d %s %d\n", inv[i].id, inv[i].name, inv[i].qty);
        }
        else if(choice == 3) {
            scanf("%d", &searchId);
            for(i = 0; i < n; i++)
                if(inv[i].id == searchId)
                    printf("%d %s %d\n", inv[i].id, inv[i].name, inv[i].qty);
        }
        else if(choice == 4) {
            scanf("%d", &searchId);
            for(i = 0; i < n; i++)
                if(inv[i].id == searchId)
                    scanf("%s %d", inv[i].name, &inv[i].qty);
        }

    } while(choice != 5);

    return 0;
}
