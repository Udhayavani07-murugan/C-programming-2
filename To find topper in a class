#include <stdio.h>

int main() {
    int n, i;
    int marks[50];
    int max, topperIndex;

    printf("Enter number of students: ");
    scanf("%d", &n);

    // Input marks
    for(i = 0; i < n; i++) {
        printf("Enter marks of student %d: ", i + 1);
        scanf("%d", &marks[i]);
    }

    // Assume first student is topper initially
    max = marks[0];
    topperIndex = 0;

    // Find topper
    for(i = 1; i < n; i++) {
        if(marks[i] > max) {
            max = marks[i];
            topperIndex = i;
        }
    }

    // Display result
    printf("\nTopper of the class:\n");
    printf("Student Number: %d\n", topperIndex + 1);
    printf("Highest Marks: %d\n", max);

    return 0;
}
