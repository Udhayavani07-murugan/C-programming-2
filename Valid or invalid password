#include <stdio.h>
#include <string.h>
#include <ctype.h>

int main() {
    char password[50];
    int i, hasDigit = 0;

    printf("Enter password: ");
    scanf("%s", password);

    // Check length
    if(strlen(password) < 6) {
        printf("Password is INVALID (must be at least 6 characters)\n");
        return 0;
    }

    // Check for at least one digit
    for(i = 0; password[i] != '\0'; i++) {
        if(isdigit(password[i])) {
            hasDigit = 1;
            break;
        }
    }

    if(hasDigit) {
        printf("Password is VALID\n");
    } else {
        printf("Password is INVALID (must contain at least one digit)\n");
    }

    return 0;
}
